# --- LLM via OpenRouter (optional: without a key the app uses deterministic reports and a rule-based chatbot) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Student Feedback Agent

# --- Tavily (optional: without a key, resource search is skipped with a message) ---
TAVILY_API_KEY=

# --- Storage ---
DATABASE_URL=sqlite:///./student_feedback.db
UPLOAD_DIRECTORY=storage/uploads
REPORT_DIRECTORY=storage/reports
CHART_DIRECTORY=storage/charts

# --- Frontend -> backend ---
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
